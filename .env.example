# Public URL of the deployment (canonical links and social cards)
NEXT_PUBLIC_SITE_URL=https://bidwright.example.com

# Optional: shown in the footer when set
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/owaiskhalid-si/bidwright

# Server-only. Free key from Google AI Studio: https://aistudio.google.com
# Without it the studio still works, replaying recorded real runs.
GEMINI_API_KEY=
# Fast model: reading, matching, critique. Writer model: drafts and revisions
# (falls back to the fast model when busy).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_WRITER_MODEL=gemini-3.6-flash

# Local/CI only: run the whole graph on a deterministic mock model, no key needed.
# BIDWRIGHT_MOCK=1
