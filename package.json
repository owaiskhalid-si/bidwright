{
  "name": "bidwright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "try": "tsx scripts/try.ts",
    "record": "tsx scripts/record.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "description": "AI proposal studio for freelancers: a LangGraph.js agent on Gemini that briefs a job post, scores fit, drafts, critiques, revises and waits for human approval.",
  "license": "MIT"
}
